{
  "functions": {
    "api/pi-server.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/validation-key.txt",
      "has": [{ "type": "host", "value": "test.shikolingo.site" }],
      "destination": "/validation-key-testnet.txt"
    },
    {
      "source": "/validation-key.txt",
      "destination": "/validation-key-mainnet.txt"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
